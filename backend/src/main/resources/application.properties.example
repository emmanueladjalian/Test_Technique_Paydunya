# Fichier d'exemple - Remplacez les valeurs par vos propres clés PayDunya
spring.application.name=paydunya-checkout

# Clés API PayDunya (Sandbox)
paydunya.master-key=VOTRE_MASTER_KEY
paydunya.private-key=VOTRE_PRIVATE_KEY
paydunya.token=VOTRE_TOKEN
paydunya.mode=test

# Port par défaut
server.port=8080